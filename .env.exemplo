# Copie para .env (que fica fora do git) e preencha.

# Token da API. Quem chama manda "Authorization: Bearer <token>". Gere com: openssl rand -hex 32
BOT_TOKEN=

# Senha do VNC (só para depuração ou para logar no Google). Vazio = VNC desligado.
VNC_SENHA=

# xorg (GPU real, padrão) ou xvfb (tela simulada).
TELA=xorg

# Opcionais (valores padrão):
# LIMITE_MEMORIA_CHROME_MB=1100
# FILA_MAXIMA=5
# TIMEOUT_PADRAO_MS=60000
# TIMEOUT_MAXIMO_MS=240000
# ATRASO_DIGITACAO_MS=25
# REDE_QUIETA_MS=1000
